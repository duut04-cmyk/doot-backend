# Runtime environment for dutt-backend.
# Copy to `.env` and fill in real values. Never commit `.env`.

NODE_ENV=development
PORT=5000
APP_NAME=Doot

# Supabase PostgreSQL
# DATABASE_URL  — runtime connection (local dev: session pooler :5432; production/serverless: transaction pooler :6543?pgbouncer=true).
# DIRECT_URL    — direct or session pooler URL for Prisma Migrate / introspection.
# Do not log these values. Server startup does not require a live DB connection.
DATABASE_URL=
DIRECT_URL=

# Auth tokens
# JWT_ACCESS_SECRET must be a strong random secret (min 32 chars). Never commit real values.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
# Reserved for future use (Part 2 uses opaque hashed refresh tokens, not JWT refresh).
JWT_REFRESH_SECRET=

# Resend email delivery
RESEND_API_KEY=
# Prefer RESEND_FROM_EMAIL; EMAIL_FROM is accepted as an alias.
RESEND_FROM_EMAIL=
EMAIL_FROM=

# Password hashing work factor (default 12)
BCRYPT_ROUNDS=12

# Post-OTP password reset verification token lifetime in seconds (default 600)
PASSWORD_RESET_VERIFICATION_TOKEN_EXPIRY_SECONDS=600

GOOGLE_CLIENT_ID=
# Not required for Google ID-token verification (Sign-In / GIS credential flow).
GOOGLE_CLIENT_SECRET=

# Browser CORS allowlist (required in production). Unset in development/test falls back to localhost defaults.
FRONTEND_URL=
ADMIN_FRONTEND_URL=

# Optional bootstrap admin for `npx prisma db seed` (never hardcode in source).
# Seed skips if either value is unset. Password is hashed with bcrypt; never logged.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AES-256-GCM key for encrypted provider credentials (32 bytes as 64-char hex or base64).
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=

# Registers the test-only MOCK provider adapter at startup (never use in production).
ENABLE_MOCK_PROVIDER_ADAPTER=false

# Customer track-page simulator (POST …/dev/advance). MOCK bookings only. Not allowed when NODE_ENV=production.
ENABLE_DEV_DELIVERY_SIMULATE=false

# Certification scripts only — never true in production (startup validation rejects it).
# EXPOSE_OTP_FOR_CERTIFICATION=false

# MSG91 smoke route POST /api/v1/test/sms (non-production only; never enable in production).
ENABLE_TEST_SMS_ENDPOINT=false

# Orchestration wall-clock budget for evaluating all providers (ms). Defaults: 15000 (dev/test), 45000 (production).
ORCHESTRATION_MAX_DURATION_MS=15000
# Local only: evaluate MOCK provider only (skip slow real providers). Rejected when NODE_ENV=production.
ORCHESTRATION_MOCK_ONLY=false
# Optional: evaluate this provider code first; fallback providers run when preferred tier has no eligible quotes and no fail-fast errors.
ORCHESTRATION_PREFERRED_PROVIDER_CODE=SHIPROCKET

# Shiprocket hyperlocal (Phase 1 — env credentials; sandbox by default)
SHIPROCKET_ENABLED=false
SHIPROCKET_API_BASE_URL=https://api-sandbox.shiprocket.in
SHIPROCKET_AUTH_EMAIL=
SHIPROCKET_AUTH_PASSWORD=

# Keep false until sandbox contracts are verified; requires SHIPROCKET_PICKUP_LOCATION when true.
SHIPROCKET_BOOKING_ENABLED=false
SHIPROCKET_PICKUP_LOCATION=

# Server-only reverse geocoding for Shiprocket postcodes (never expose to clients)
GOOGLE_GEOCODING_API_KEY=

# Optional inputs for npm run probe:shiprocket-sandbox (CLI flags override)
# SHIPROCKET_PROBE_PICKUP_POSTCODE=
# SHIPROCKET_PROBE_DELIVERY_POSTCODE=
# SHIPROCKET_PROBE_LAT_FROM=
# SHIPROCKET_PROBE_LONG_FROM=
# SHIPROCKET_PROBE_LAT_TO=
# SHIPROCKET_PROBE_LONG_TO=
# SHIPROCKET_PROBE_WEIGHT=

# Booking confirmation (Phase 6)
BOOKING_QUOTE_MAX_AGE_SECONDS=300
BOOKING_PRICE_TOLERANCE_PERCENT=0
PLATFORM_SERVICE_FEE_PERCENT=10

# Delivery OTP (Phase 7)
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_GENERATION_COOLDOWN_SECONDS=60

# Operational pickup/delivery OTP SMS (SMS-only). Provider: mock | msg91 | twilio
SMS_PROVIDER=mock
# Local Twilio test example:
# SMS_PROVIDER=twilio
# MSG91_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Opt-in trial template smoke only (npm run smoke:twilio-trial-template). Does not use Doot OTP endpoints.
# TWILIO_TRIAL_TEST_TO must be a verified trial handset you control (never a customer contact).
# TWILIO_TRIAL_TEMPLATE must be one of: sms_delivery_updates | sms_appointment_reminders | sms_order_confirmation | sms_2fa
# TWILIO_TRIAL_TEST_TO=
# TWILIO_TRIAL_TEMPLATE=
# Non-production: route pickup/drop OTP SMS to one verified handset (Twilio trial)
# SMS_OTP_RECIPIENT_OVERRIDE=918699486836

# MSG91 SMS (when SMS_PROVIDER=msg91 and MSG91_ENABLED=true)
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DOOT
MSG91_ACCOUNT_OTP_TEMPLATE_ID=
MSG91_PICKUP_OTP_TEMPLATE_ID=
MSG91_DELIVERY_OTP_TEMPLATE_ID=
MSG91_API_BASE_URL=https://api.msg91.com/api/v5
MSG91_TIMEOUT_MS=10000

# Background operational provider polling (unified getTracking refresh)
OPERATIONAL_POLLING_ENABLED=false
OPERATIONAL_POLL_INTERVAL_MS=60000
OPERATIONAL_POLL_BATCH_SIZE=50

# Cloudflare R2 — optional on API for private-bucket signed read URLs in delivery/history.
# Upload presign lives on customer-platform Next.js (see customer-platform/.env.local.example).
R2_PUBLIC_BASE_URL=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=doot

# Payment gateway — stub (local/mock default below) or cashfree (required for NODE_ENV=production)
# Secrets stay on the backend (local .env or Render env). Never put Cashfree
# client secret in customer-platform. Frontend only needs public checkout flags
# (see customer-platform/.env.local.example).
PAYMENT_GATEWAY=stub
CASHFREE_ENABLED=false
# sandbox | production — production is rejected by config validation
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
# Customer return URL after checkout (e.g. http://localhost:3000/checkout/success)
CASHFREE_RETURN_URL=
# Public HTTPS notify URL for Cashfree → backend webhooks (ngrok in local).
# Setting this alone does NOT prove external webhook delivery — verify from
# Cashfree dashboard / ngrok traffic that PAYMENT_* / REFUND_* posts arrive.
CASHFREE_NOTIFY_URL=
CASHFREE_WEBHOOK_ENABLED=false

# Cashfree sandbox E2E certification (npm run cert:cashfree-sandbox)
# CASHFREE_CERT_PAID_TIMEOUT_MS=300000
# CASHFREE_CERT_REFUND_TIMEOUT_MS=120000
# CASHFREE_CERT_POLL_INTERVAL_MS=2500
# CASHFREE_CERT_RUN_SIMULATED_WEBHOOK=false
# CASHFREE_CERT_REQUIRE_EXTERNAL_WEBHOOK=false
# CASHFREE_CERT_DELIVERY_ID=
