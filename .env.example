# Runtime environment for dutt-backend.
# Copy to `.env` and fill in real values. Never commit `.env`.

NODE_ENV=development
PORT=5000
APP_NAME=Doot

# Supabase PostgreSQL
# DATABASE_URL  — runtime connection (local dev: session pooler :5432; production/serverless: transaction pooler :6543?pgbouncer=true).
# DIRECT_URL    — direct or session pooler URL for Prisma Migrate / introspection.
# Do not log these values. Server startup does not require a live DB connection.
DATABASE_URL=
DIRECT_URL=

# Auth tokens
# JWT_ACCESS_SECRET must be a strong random secret (min 32 chars). Never commit real values.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
# Reserved for future use (Part 2 uses opaque hashed refresh tokens, not JWT refresh).
JWT_REFRESH_SECRET=

# Resend email delivery
RESEND_API_KEY=
# Prefer RESEND_FROM_EMAIL; EMAIL_FROM is accepted as an alias.
RESEND_FROM_EMAIL=
EMAIL_FROM=

# Password hashing work factor (default 12)
BCRYPT_ROUNDS=12

# Post-OTP password reset verification token lifetime in seconds (default 600)
PASSWORD_RESET_VERIFICATION_TOKEN_EXPIRY_SECONDS=600

GOOGLE_CLIENT_ID=
# Not required for Google ID-token verification (Sign-In / GIS credential flow).
GOOGLE_CLIENT_SECRET=

FRONTEND_URL=
ADMIN_FRONTEND_URL=

# Optional bootstrap admin for `npx prisma db seed` (never hardcode in source).
# Seed skips if either value is unset. Password is hashed with bcrypt; never logged.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AES-256-GCM key for encrypted provider credentials (32 bytes as 64-char hex or base64).
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=

# Registers the test-only MOCK provider adapter at startup (never use in production).
ENABLE_MOCK_PROVIDER_ADAPTER=false

# Optional manual Borzo sandbox smoke test (scripts/borzo-sandbox-smoke.ts).
# Never commit real Borzo credentials.
BORZO_SANDBOX_SMOKE_TEST=false
BORZO_ACCESS_TOKEN=

# Borzo inbound webhooks (Phase 4B — POST /api/v1/providers/borzo/webhooks).
# HMAC-SHA256 secret shared with Borzo for X-DV-Signature verification (min 16 chars).
BORZO_WEBHOOKS_ENABLED=false
BORZO_CALLBACK_SECRET=

# Booking confirmation (Phase 6)
BOOKING_QUOTE_MAX_AGE_SECONDS=300
BOOKING_PRICE_TOLERANCE_PERCENT=0

# Delivery OTP (Phase 7)
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_GENERATION_COOLDOWN_SECONDS=60
