generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime / pooled connection (Supabase connection pooler).
  url       = env("DATABASE_URL")
  // Direct connection for Prisma Migrate (bypasses the pooler).
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum DeliveryStatus {
  CREATED
  ORCHESTRATING
  OPTION_READY
  BOOKING
  BOOKED
  DRIVER_ASSIGNED
  PICKUP_OTP_PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERY_OTP_PENDING
  DELIVERED
  CANCELLED
  FAILED
}

enum PackageType {
  MEDICINE
  FOOD
  DOCUMENT
  OTHER
}

enum PackageSizeTier {
  SMALL
  MEDIUM
  LARGE
}

enum HandlingRequirement {
  HANDLE_WITH_CARE
  FRAGILE
  KEEP_UPRIGHT
}

enum ScheduleMode {
  ASAP
  SCHEDULED
}

enum StatusEventSource {
  SYSTEM
  CUSTOMER
  ADMIN
  PROVIDER
  WEBHOOK
  ORCHESTRATION
  BOOKING
  OTP
  TRACKING
}

// ---------------------------------------------------------------------------
// Auth models
// Application layer must normalize emails (e.g. trim + lowercase) before writes.
// Never store plaintext passwords, OTPs, reset tokens, or refresh tokens.
// Email verification OTPs are valid for 15 minutes (enforced in application code).
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  phoneCountryCode String?
  phoneNumber      String?
  passwordHash  String?
  emailVerified Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  role          UserRole   @default(CUSTOMER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  oauthAccounts         OAuthAccount[]
  emailVerificationOtps            EmailVerificationOtp[]
  passwordResetOtps                PasswordResetOtp[]
  passwordResetVerificationTokens  PasswordResetVerificationToken[]
  refreshTokens                    RefreshToken[]
  deliveries            Delivery[]
  deliveryRatings       DeliveryRating[]
  deliveryFeedbacks     DeliveryFeedback[]
  adminAuditLogs        AdminAuditLog[]
  orchestrationRequests OrchestrationRequest[]
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailVerificationOtp {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetOtp {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model PasswordResetVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ---------------------------------------------------------------------------
// Delivery foundation (Phase 1)
// Geo, providers, pricing, booking, OTP, and tracking are intentionally deferred.
// ---------------------------------------------------------------------------

model Delivery {
  id                  String         @id @default(uuid()) @db.Uuid
  reference           String         @unique
  customerId          String         @db.Uuid
  status              DeliveryStatus @default(CREATED)
  specialInstructions String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  customer       User                           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pickup         DeliveryPickup?
  drop           DeliveryDrop?
  package        DeliveryPackage?
  schedule       DeliverySchedule?
  compliance     DeliveryCompliance?
  requirements   DeliveryHandlingRequirement[]
  statusEvents          DeliveryStatusEvent[]
  idempotencyKey        DeliveryIdempotencyKey?
  orchestrationRequests OrchestrationRequest[]
  providerBookings      ProviderBooking[]
  bookingConfirmKeys    BookingConfirmIdempotencyKey[]
  driverAssignments     DriverAssignment[]
  deliveryOtps          DeliveryOtp[]
  trackingPoints        DeliveryTrackingPoint[]
  cancellations         DeliveryCancellation[]
  cancellationKeys      CancellationIdempotencyKey[]
  rating                DeliveryRating?
  feedback              DeliveryFeedback?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([customerId, createdAt])
}

model DeliveryPickup {
  id           String  @id @default(uuid()) @db.Uuid
  deliveryId   String  @unique @db.Uuid
  addressText  String
  contactName  String
  contactPhoneCountryCode String
  contactPhoneNumber      String
  instructions            String?
  latitude                Decimal? @db.Decimal(10, 7)
  longitude               Decimal? @db.Decimal(10, 7)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model DeliveryDrop {
  id           String  @id @default(uuid()) @db.Uuid
  deliveryId   String  @unique @db.Uuid
  addressText  String
  contactName  String
  contactPhoneCountryCode String
  contactPhoneNumber      String
  instructions String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model DeliveryPackage {
  id          String          @id @default(uuid()) @db.Uuid
  deliveryId  String          @unique @db.Uuid
  packageType PackageType
  description String?
  weightKg    Decimal         @db.Decimal(10, 3)
  lengthCm    Decimal?        @db.Decimal(10, 2)
  widthCm     Decimal?        @db.Decimal(10, 2)
  heightCm    Decimal?        @db.Decimal(10, 2)
  sizeTier    PackageSizeTier
  quantity    Int             @default(1)

  delivery Delivery               @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  photos   DeliveryPackagePhoto[]
}

model DeliveryPackagePhoto {
  id              String   @id @default(uuid()) @db.Uuid
  packageId       String   @db.Uuid
  objectKey       String
  storageProvider String   @default("PENDING")
  mimeType        String?
  fileSizeBytes   Int?
  createdAt       DateTime @default(now())

  package DeliveryPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@unique([packageId, objectKey])
}

model DeliveryHandlingRequirement {
  id          String              @id @default(uuid()) @db.Uuid
  deliveryId  String              @db.Uuid
  requirement HandlingRequirement

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, requirement])
  @@index([deliveryId])
}

model DeliverySchedule {
  id          String       @id @default(uuid()) @db.Uuid
  deliveryId  String       @unique @db.Uuid
  mode        ScheduleMode
  timezone    String
  scheduledAt DateTime?
  windowStart DateTime?
  windowEnd   DateTime?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model DeliveryCompliance {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @unique @db.Uuid
  accepted   Boolean
  acceptedAt DateTime

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model DeliveryStatusEvent {
  id         String             @id @default(uuid()) @db.Uuid
  deliveryId String             @db.Uuid
  fromStatus DeliveryStatus?
  toStatus   DeliveryStatus
  source     StatusEventSource
  reason     String?
  metadata   Json?
  createdAt  DateTime           @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([createdAt])
}

model DeliveryIdempotencyKey {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @db.Uuid
  key             String
  requestHash     String
  deliveryId      String   @unique @db.Uuid
  responsePayload Json
  createdAt       DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Provider registry (Phase 2) — configuration only, no external API calls yet.
// ---------------------------------------------------------------------------

enum ProviderStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProviderEnvironment {
  SANDBOX
  LIVE
}

enum ProviderIntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  READY
  ERROR
}

enum ProviderHealthStatus {
  UNKNOWN
  HEALTHY
  UNHEALTHY
}

enum ProviderCapability {
  SERVICEABILITY
  AVAILABILITY
  PRICING
  BOOKING
  DRIVER_INFO
  DRIVER_RATING
  VEHICLE_INFO
  LIVE_TRACKING
  TRACKING_URL
  WEBHOOKS
  OTP
  CANCELLATION
}

enum ProviderServiceType {
  BIKE
  SCOOTER
  CAR
  VAN
  TRUCK
  HYPERLOCAL
  SAME_DAY
  EXPRESS
  SCHEDULED
}

enum ProviderVehicleType {
  BIKE
  SCOOTER
  CAR
  VAN
  TRUCK
}

enum ProviderCredentialField {
  API_KEY
  API_SECRET
  ACCESS_TOKEN
  CLIENT_ID
  CLIENT_SECRET
  USERNAME
  PASSWORD
  ACCOUNT_ID
  WEBHOOK_SECRET
}

enum AdminAuditAction {
  PROVIDER_CREATED
  PROVIDER_UPDATED
  PROVIDER_ENABLED
  PROVIDER_DISABLED
  PROVIDER_STATUS_CHANGED
  PROVIDER_CREDENTIALS_UPDATED
  PROVIDER_CAPABILITIES_UPDATED
  PROVIDER_SERVICE_CREATED
  PROVIDER_SERVICE_UPDATED
  PROVIDER_SERVICE_DISABLED
  PROVIDER_VEHICLE_CREATED
  PROVIDER_VEHICLE_UPDATED
}

enum AdminAuditResourceType {
  PROVIDER
  PROVIDER_SERVICE
  PROVIDER_VEHICLE
  PROVIDER_CREDENTIALS
  PROVIDER_CAPABILITIES
}

model Provider {
  id                  String                    @id @default(uuid()) @db.Uuid
  code                String                    @unique
  name                String
  displayName         String?
  description         String?
  status              ProviderStatus            @default(INACTIVE)
  environment         ProviderEnvironment       @default(SANDBOX)
  enabled             Boolean                   @default(false)
  orchestrationEnabled Boolean                  @default(false)
  priority            Int                       @default(100)
  integrationStatus   ProviderIntegrationStatus @default(NOT_CONFIGURED)
  healthStatus        ProviderHealthStatus      @default(UNKNOWN)
  lastHealthCheckAt   DateTime?
  lastHealthCheckError String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  settings     ProviderSettings?
  packageLimits ProviderPackageLimits?
  credentials  ProviderCredential[]
  capabilities ProviderCapabilityRecord[]
  services     ProviderService[]
  vehicles     ProviderVehicle[]

  @@index([status])
  @@index([enabled])
  @@index([orchestrationEnabled])
  @@index([priority])
}

model ProviderSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  providerId          String   @unique @db.Uuid
  timeoutMs           Int      @default(30000)
  connectTimeoutMs    Int      @default(10000)
  maxRetries          Int      @default(2)
  retryDelayMs        Int      @default(1000)
  webhookEnabled      Boolean  @default(false)
  healthCheckEnabled  Boolean  @default(true)
  healthCheckIntervalMs Int    @default(300000)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderPackageLimits {
  id                    String   @id @default(uuid()) @db.Uuid
  providerId            String   @unique @db.Uuid
  minWeightKg           Decimal? @db.Decimal(10, 3)
  maxWeightKg           Decimal? @db.Decimal(10, 3)
  maxLengthCm           Decimal? @db.Decimal(10, 2)
  maxWidthCm            Decimal? @db.Decimal(10, 2)
  maxHeightCm           Decimal? @db.Decimal(10, 2)
  maxVolumeCm3          Decimal? @db.Decimal(14, 2)
  supportedPackageTypes PackageType[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderCredential {
  id         String                  @id @default(uuid()) @db.Uuid
  providerId String                  @db.Uuid
  fieldName  ProviderCredentialField
  ciphertext String
  iv         String
  authTag    String
  isActive   Boolean                 @default(true)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([providerId, isActive])
}

model ProviderCapabilityRecord {
  id         String             @id @default(uuid()) @db.Uuid
  providerId String             @db.Uuid
  capability ProviderCapability

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capability])
  @@index([providerId])
}

model ProviderService {
  id          String              @id @default(uuid()) @db.Uuid
  providerId  String              @db.Uuid
  code        String
  name        String
  serviceType ProviderServiceType
  description String?
  enabled     Boolean             @default(true)
  priority    Int                 @default(100)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, code])
  @@index([providerId])
  @@index([providerId, enabled])
}

model ProviderVehicle {
  id          String              @id @default(uuid()) @db.Uuid
  providerId  String              @db.Uuid
  vehicleType ProviderVehicleType
  enabled     Boolean             @default(true)
  maxWeightKg Decimal?            @db.Decimal(10, 3)
  maxLengthCm Decimal?            @db.Decimal(10, 2)
  maxWidthCm  Decimal?            @db.Decimal(10, 2)
  maxHeightCm Decimal?            @db.Decimal(10, 2)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, vehicleType])
  @@index([providerId])
}

model AdminAuditLog {
  id           String                 @id @default(uuid()) @db.Uuid
  adminUserId  String                 @db.Uuid
  action       AdminAuditAction
  resourceType AdminAuditResourceType
  resourceId   String                 @db.Uuid
  requestId    String
  metadata     Json?
  createdAt    DateTime               @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

enum ProviderWebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model ProviderWebhookEvent {
  id                 String                          @id @default(uuid()) @db.Uuid
  providerCode       String
  eventType          String
  providerEventKey   String                          @unique
  providerOrderId    String?
  providerDeliveryId String?
  eventDatetime      DateTime
  receivedAt         DateTime                        @default(now())
  signatureVerified  Boolean
  processingStatus   ProviderWebhookProcessingStatus @default(RECEIVED)
  processedAt        DateTime?
  processingError    String?
  payloadHash        String
  payload            Json
  normalizedEvent    Json?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@index([providerCode])
  @@index([providerOrderId])
  @@index([providerDeliveryId])
  @@index([eventType])
  @@index([receivedAt])
  @@index([processingStatus])
}

// ---------------------------------------------------------------------------
// Orchestration (Phase 5) — provider evaluation and option selection only.
// ---------------------------------------------------------------------------

enum OrchestrationRequestStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum OrchestrationEvaluationStatus {
  EVALUATED
  ELIGIBLE
  INELIGIBLE
  ERROR
  SKIPPED
}

model OrchestrationRequest {
  id                String                     @id @default(uuid()) @db.Uuid
  deliveryId        String                     @db.Uuid
  requestedByUserId String                     @db.Uuid
  attemptNumber     Int
  status            OrchestrationRequestStatus
  failureReason     String?
  startedAt         DateTime                   @default(now())
  completedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  delivery       Delivery                  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  requestedBy    User                      @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  evaluations    OrchestrationEvaluation[]
  selectedOption OrchestrationOption?

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId])
  @@index([status])
  @@index([createdAt])
}

model OrchestrationEvaluation {
  id                     String                        @id @default(uuid()) @db.Uuid
  orchestrationRequestId String                        @db.Uuid
  providerId             String                        @db.Uuid
  providerServiceId      String?                       @db.Uuid
  providerCode           String
  providerServiceCode    String?
  status                 OrchestrationEvaluationStatus
  serviceable            Boolean?
  availabilityKnown      Boolean?
  available              Boolean?
  availableDriverCount   Int?
  quoteAvailable         Boolean?
  quoteAmount            Decimal?                      @db.Decimal(12, 2)
  quoteCurrency          String?
  estimatedDeliveryAt    DateTime?
  eligibilityReasons     Json                          @default("[]")
  exclusionReasons       Json                          @default("[]")
  warnings               Json                          @default("[]")
  score                  Decimal?                      @db.Decimal(8, 4)
  scoreBreakdown         Json?
  normalizedResult       Json?
  providerMetadata       Json?
  errorCategory          String?
  createdAt              DateTime                      @default(now())

  orchestrationRequest OrchestrationRequest @relation(fields: [orchestrationRequestId], references: [id], onDelete: Cascade)
  selectedOption       OrchestrationOption?

  @@index([orchestrationRequestId])
  @@index([providerId])
  @@index([status])
}

model OrchestrationOption {
  id                     String   @id @default(uuid()) @db.Uuid
  orchestrationRequestId String   @unique @db.Uuid
  evaluationId           String   @unique @db.Uuid
  providerId             String   @db.Uuid
  providerServiceId      String?  @db.Uuid
  providerCode           String
  providerServiceCode    String?
  score                  Decimal  @db.Decimal(8, 4)
  scoreBreakdown         Json
  selectionReason        String
  quoteSnapshot               Json
  availabilitySnapshot        Json?
  etaSnapshot                 Json?
  cancellationPolicySnapshot  Json?
  createdAt                   DateTime @default(now())

  orchestrationRequest OrchestrationRequest  @relation(fields: [orchestrationRequestId], references: [id], onDelete: Cascade)
  evaluation           OrchestrationEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

// ---------------------------------------------------------------------------
// Provider booking (Phase 6) — customer confirmation and provider create-order.
// ---------------------------------------------------------------------------

enum ProviderBookingStatus {
  PENDING
  BOOKING
  BOOKED
  FAILED
  UNKNOWN
}

model ProviderBooking {
  id                     String                @id @default(uuid()) @db.Uuid
  deliveryId             String                @db.Uuid
  attemptNumber          Int
  orchestrationRequestId String                @db.Uuid
  orchestrationOptionId  String                @db.Uuid
  providerId             String                @db.Uuid
  providerServiceId      String?               @db.Uuid
  providerCode           String
  providerServiceCode    String?
  status                 ProviderBookingStatus
  correlationReference   String                @unique
  providerOrderId        String?
  providerReference      String?
  providerStatus         String?
  quotedAmount           Decimal?              @db.Decimal(12, 2)
  quotedCurrency         String?
  bookedAmount           Decimal?              @db.Decimal(12, 2)
  bookedCurrency         String?
  providerQuoteId        String?
  quoteSnapshot          Json
  unknownOutcome         Boolean               @default(false)
  failureCode            String?
  failureMessage         String?
  requestId              String?
  bookedAt               DateTime?
  failedAt               DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId])
  @@index([providerId])
  @@index([status])
  @@index([providerOrderId])
  @@index([createdAt])
}

model BookingConfirmIdempotencyKey {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @db.Uuid
  key             String
  requestHash     String
  deliveryId      String   @db.Uuid
  responsePayload Json
  createdAt       DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@index([customerId])
  @@index([deliveryId])
}

// ---------------------------------------------------------------------------
// Operational lifecycle (Phase 7) — driver, OTP, tracking, cancellation.
// ---------------------------------------------------------------------------

enum DriverAssignmentStatus {
  PENDING
  ASSIGNED
  UNASSIGNED
  UNKNOWN
}

enum OperationalDataSource {
  PROVIDER_POLL
  PROVIDER_WEBHOOK
  BOOKING_RESPONSE
  SYSTEM
}

enum DeliveryOtpType {
  PICKUP
  DELIVERY
}

enum CancellationStatus {
  REQUESTED
  PROCESSING
  CANCELLED
  REJECTED
  UNKNOWN
}

enum TrackingPointSource {
  PROVIDER_POLL
  PROVIDER_WEBHOOK
  SYSTEM
}

model DriverAssignment {
  id                String                 @id @default(uuid()) @db.Uuid
  deliveryId        String                 @db.Uuid
  providerBookingId String                 @db.Uuid
  providerId        String                 @db.Uuid
  providerDriverId  String?
  driverName        String?
  driverPhoneCountryCode String?
  driverPhoneNumber      String?
  driverPhotoUrl    String?
  providerRating    Decimal?               @db.Decimal(4, 2)
  vehicleType       String?
  vehicleNumber     String?
  assignedAt        DateTime?
  status            DriverAssignmentStatus
  source            OperationalDataSource
  providerStatus    String?
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([providerBookingId])
  @@index([status])
}

model DeliveryOtp {
  id          String          @id @default(uuid()) @db.Uuid
  deliveryId  String          @db.Uuid
  type        DeliveryOtpType
  codeHash    String
  expiresAt   DateTime
  attempts    Int             @default(0)
  maxAttempts Int             @default(5)
  consumedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, type])
  @@index([expiresAt])
}

model DeliveryTrackingPoint {
  id                String              @id @default(uuid()) @db.Uuid
  deliveryId        String              @db.Uuid
  providerBookingId String              @db.Uuid
  providerId        String              @db.Uuid
  providerEventId   String?
  latitude          Decimal?            @db.Decimal(10, 7)
  longitude         Decimal?            @db.Decimal(10, 7)
  accuracyMeters    Int?
  providerTimestamp DateTime?
  receivedAt        DateTime
  eta               DateTime?
  providerStatus    String?
  normalizedStatus  String?
  trackingUrl       String?
  source            TrackingPointSource
  metadata          Json?
  createdAt         DateTime            @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@index([providerBookingId])
}

model DeliveryCancellation {
  id                            String             @id @default(uuid()) @db.Uuid
  deliveryId                    String             @db.Uuid
  providerBookingId             String?            @db.Uuid
  providerId                    String?            @db.Uuid
  reasonCode                    String
  reasonMessage                 String?
  status                        CancellationStatus
  correlationReference          String             @unique
  providerCancellationReference String?
  cancelledAt                   DateTime?
  requestedAt                   DateTime           @default(now())
  failureCode                   String?
  failureMessage                String?
  requestId                     String?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([status])
}

model CancellationIdempotencyKey {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @db.Uuid
  key             String
  requestHash     String
  deliveryId      String   @db.Uuid
  responsePayload Json
  createdAt       DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@index([deliveryId])
}

// ---------------------------------------------------------------------------
// Rating & feedback (Phase 8)
// ---------------------------------------------------------------------------

enum FeedbackPositiveTag {
  DRIVER_POLITE
  DRIVER_PROFESSIONAL
  FAST_DELIVERY
  EASY_BOOKING
  GOOD_COMMUNICATION
  PACKAGE_HANDLED_WELL
}

enum FeedbackIssueTag {
  DRIVER_LATE
  DRIVER_UNPROFESSIONAL
  DELIVERY_DELAYED
  COMMUNICATION_ISSUE
  PACKAGE_HANDLING_ISSUE
  TRACKING_ISSUE
  OTHER
}

model DeliveryRating {
  id             String   @id @default(uuid()) @db.Uuid
  deliveryId     String   @unique @db.Uuid
  customerId     String   @db.Uuid
  driverRating   Int
  deliveryRating Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  customer User     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
}

model DeliveryFeedback {
  id           String                @id @default(uuid()) @db.Uuid
  deliveryId   String                @unique @db.Uuid
  customerId   String                @db.Uuid
  positiveTags FeedbackPositiveTag[]
  issueTags    FeedbackIssueTag[]
  comment      String?               @db.VarChar(1000)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  customer User     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
}
